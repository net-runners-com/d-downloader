{
  "manifest_version": 3,
  "name": "ダイレクトアカデミー 講座ダウンローダー",
  "version": "0.3.3",
  "description": "dpub.jp のライブラリで講座を複数選択し、章・PART・関連教材を選んで、任意のフォルダに動画(HLS)と資料を保存します。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://dpub.jp/*",
    "https://*.wistia.com/*",
    "https://*.wistia.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "講座ダウンローダー"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dpub.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
